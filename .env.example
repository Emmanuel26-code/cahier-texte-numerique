# Copier ce fichier en ".env" et remplir les valeurs (le .env n'est JAMAIS commité).
# En production (Vercel), ces variables se saisissent dans Settings > Environment Variables.

# --- Django ---------------------------------------------------------------------------
# Obligatoire en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi
# True uniquement sur un poste de développement (False ou absent en production)
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Domaines supplémentaires (ex. nom de domaine personnalisé), séparés par des virgules :
# DJANGO_ALLOWED_HOSTS=cahier.mon-ecole.ci
# DJANGO_CSRF_TRUSTED_ORIGINS=https://cahier.mon-ecole.ci

# --- Base de données -------------------------------------------------------------------
# Production : une seule variable (PostgreSQL de Neon/Vercel, ou MySQL distant)
# DATABASE_URL=postgres://utilisateur:mot_de_passe@hote/base?sslmode=require
# Développement local (MySQL de XAMPP), utilisé si DATABASE_URL est absent :
DB_NAME=cahier_texte
DB_USER=cahier_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Stockage des documents importés ---------------------------------------------------
# Vide = disque local (dossier media/). Obligatoire sur Vercel : un stockage compatible S3
# (Cloudflare R2, Supabase Storage, AWS S3...).
# S3_BUCKET=cahier-texte-documents
# S3_ENDPOINT_URL=https://<id-du-compte>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Taille max d'un document (octets). Sur Vercel, ne pas dépasser 4 Mo : 4194304
DOCUMENT_MAX_OCTETS=10485760

# --- Module IA (plan de cours) — clé à créer sur https://aistudio.google.com/apikey -------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IA_TIMEOUT_SECONDS=60
IA_MAX_CHARS=60000
IA_MAX_FILE_BYTES=10485760
IA_MAX_PAGES=200
IA_MAX_GENERATIONS_PAR_HEURE=20
