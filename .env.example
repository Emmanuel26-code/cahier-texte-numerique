# Copier ce fichier en ".env" et remplir les valeurs (le .env n'est JAMAIS commité)
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=cahier_texte
DB_USER=cahier_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Module IA (plan de cours) — clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IA_TIMEOUT_SECONDS=60
IA_MAX_CHARS=60000
IA_MAX_FILE_BYTES=10485760
IA_MAX_PAGES=200
IA_MAX_GENERATIONS_PAR_HEURE=20
